{
    "name": "adityadarma/laravel-service-repository",
    "description": "Create pattern service and repository with easy",
    "keywords": ["laravel", "service pattern", "repository pattern", "service repository pattern"],
    "homepage": "https://github.com/adityadarma/laravel-service-repository",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Aditya Darma",
            "email": "adhit.boys1@gmail.com"
        }
    ],
    "require": {
        "php": "^8.0",
        "laravel/framework": "^9.0|^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "AdityaDarma\\LaravelServiceRepository\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AdityaDarma\\LaravelServiceRepository\\LaravelServiceRepositoryServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "optimize-autoloader": true
    },
    "minimum-stability": "stable"
}
